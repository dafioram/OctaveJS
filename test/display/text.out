>> t = true
t =
     1
>> tf = [true false; false true]
tf =
     1     0
     0     1
>> str = 'hello'
str =
hello
>> cm = ['abc'; 'def']
cm =
abc
def
>> disp('plain text')
plain text
>> disp([1 2 3])
     1     2     3
>> disp(pi)
    3.1416
>> fprintf('%d apples, %.2f pears\n', 3, 2.5)
3 apples, 2.50 pears
>> fprintf('%s|', 'a', 'bc'); fprintf('\n')
a|bc|
>> x = sprintf('%5.1f', [1.25 -2.5])
x =
  1.3 -2.5
